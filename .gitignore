# Editor
.idea/
.vscode/

# Local Claude Code project state (artefacts from running /init on this repo itself,
# not part of the framework source)
.claude/
.project/

# Stray directories that only appear if someone runs /init inside this repo
/agents/
/spec/
/sprints/
/workflows/

# Inside skills/, only track framework source files.
# Anything else in that dir is a stray /init artefact.
/skills/*
!/skills/init.md
!/skills/init.codex.md
!/skills/sprint.md
!/skills/sprint.codex.md
!/skills/run-agent.md
!/skills/run-agent.codex.md
!/skills/run-workflow.md
!/skills/run-workflow.codex.md
!/skills/upgrade-project.md
!/skills/upgrade-project.codex.md
!/skills/push-to-github.md
!/skills/create-pr.md
!/skills/documentation-from-commits.md
!/skills/reload-projects.md

# Common backup files
*.bak
*.bak.*
